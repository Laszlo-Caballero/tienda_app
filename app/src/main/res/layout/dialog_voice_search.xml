<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:clipToPadding="false">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Búsqueda por Voz"
            android:textColor="#0B1C33"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/btnVoiceClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_scan_focus"
            app:tint="#64748B"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cerrar búsqueda por voz" />
    </RelativeLayout>

    <!-- Visualizer / Wave Area -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginVertical="24dp">

        <!-- Outer Pulse circle -->
        <View
            android:id="@+id/viewVoicePulse"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_yellow"
            android:alpha="0.2"/>

        <!-- Middle static circle -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_light" />

        <!-- Inner Mic Icon -->
        <ImageView
            android:id="@+id/ivVoiceMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            app:tint="#0B1C33"
            android:importantForAccessibility="no" />

        <!-- Loading spinner (hidden by default) -->
        <ProgressBar
            android:id="@+id/pbVoiceLoading"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:indeterminateTint="#0B1C33"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Dynamic Status text -->
    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escuchando..."
        android:textColor="#0B1C33"
        android:textSize="18sp"
        android:textStyle="bold"
        android:accessibilityLiveRegion="assertive" />

    <!-- Live recognized query transcription -->
    <TextView
        android:id="@+id/tvVoiceQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minLines="1"
        android:gravity="center"
        android:text="..."
        android:textColor="#64748B"
        android:textSize="15sp"
        android:textStyle="italic" />

    <!-- Action buttons (like Retry) -->
    <Button
        android:id="@+id/btnVoiceRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#0B1C33"
        android:textColor="#FFFFFF"
        android:text="Reintentar"
        android:textStyle="bold"
        android:visibility="gone"
        android:contentDescription="Reintentar búsqueda por voz" />

</LinearLayout>
