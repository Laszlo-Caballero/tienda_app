<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.search.SearchFragment">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B1C33"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_eye"
            app:tint="#FFFFFF"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Asistente\nVisionario"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_user"
            app:tint="#FFFFFF"
            android:contentDescription="Perfil de usuario" />
    </LinearLayout>

    <!-- Search Card Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="#64748B"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Buscar por nombre, marca o ID..."
                android:textColor="#0B1C33"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:nextFocusDown="@id/rvSearchResults"
                android:importantForAutofill="no"
                android:contentDescription="Escribe para buscar productos" />

            <ImageView
                android:id="@+id/btnSearchClear"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_scan_focus"
                android:visibility="gone"
                app:tint="#94A3B8"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Limpiar texto de búsqueda" />

            <ImageView
                android:id="@+id/btnVoiceSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_mic"
                android:visibility="visible"
                app:tint="#64748B"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Buscar por voz" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Counter View with Accessibility Live Region -->
    <TextView
        android:id="@+id/tvSearchCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="0 productos encontrados"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:accessibilityLiveRegion="polite"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Results List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/tvSearchCounter"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_analysis_result"/>

    <!-- Centered Loading State Indicator -->
    <ProgressBar
        android:id="@+id/pbSearchLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:indeterminateTint="#0B1C33"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Empty State / No Results Layout -->
    <LinearLayout
        android:id="@+id/lytEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_laptop"
            app:tint="#CBD5E1"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se encontraron productos"
            android:textColor="#4A5568"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intenta buscar con otros términos o códigos de barra."
            android:textColor="#718096"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:focusable="true"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
