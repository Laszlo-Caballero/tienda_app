<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:padding="24dp">

    <!-- Small horizontal bar to drag the BottomSheet -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#475569"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern Card containing Gradient with Details -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPromo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Gradient background for Premium style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_promo_gradient"
            android:padding="24dp"
            android:gravity="center">

            <!-- Confetti Icon or celebration badge -->
            <ImageView
                android:id="@+id/imgPromoIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_scan_focus"
                app:tint="#FCD400"
                android:importantForAccessibility="no"
                android:layout_marginBottom="16dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvPromoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Bono Misterioso! 🎁"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:accessibilityHeading="true" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvPromoDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Has obtenido un descuento increíble por tu escaneo QR."
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Code Container (Badge) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_badge"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvPromoCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CUPON_REVELADO"
                    android:textColor="#FCD400"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Código de descuento listo para usar"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Interactive Claim Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnClaim"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_claim_button"
        android:text="Reclamar Bono ⚡"
        android:textColor="#6E5C00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/cardPromo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dismiss Text / Button for screen readers and simple tap -->
    <TextView
        android:id="@+id/tvDismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cerrar y continuar"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnClaim"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
